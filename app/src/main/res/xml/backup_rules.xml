<?xml version="1.0" encoding="utf-8"?>
<!--
    ByeBox never includes proxy configs, subscriptions or credentials in
    cloud backup or device transfer (Android API 24–30).
    The app ships its own in-app backup (SettingsBackup) instead.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>